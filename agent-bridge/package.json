{
  "name": "eyepatch-agent-bridge",
  "version": "0.1.0",
  "description": "Agent Bridge for the Eyepatch Chrome extension: runs coding agents over ACP",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "agent-bridge": "src/main.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts dev",
    "register:dev": "bun src/main.ts install --dev",
    "unregister": "bun src/main.ts uninstall",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "fake-extension": "bun scripts/fake-extension.ts",
    "test:e2e": "bun scripts/test-e2e.mjs",
    "test:gm": "bun scripts/gm/test-gm.mjs",
    "test:update": "bun scripts/test-update.mjs",
    "package:extension": "bun scripts/package-extension.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.7.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  }
}
