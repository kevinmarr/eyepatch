{
  "manifest_version": 3,
  "name": "Eyepatch",
  "version": "0.1.0",
  "description": "Change how any website looks and works by chatting with a coding agent on your computer.",
  "minimum_chrome_version": "135",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "userScripts",
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "notifications",
    "nativeMessaging",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_permissions": [
    "downloads",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Eyepatch",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "options.html"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ]
}
